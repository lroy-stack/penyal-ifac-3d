    {
      "text": {
        "es": "Estás en el Centro de Visitantes del Parque Natural del Penyal d'Ifac, declarado parque natural en 1987."
      },
      "facts": ["centre-name", "park-declaration"]
    },
    {
      "text": {
        "es": "Para subir a la cima hace falta reserva: es personal, una por persona y día, incluidos los niños, y se puede hacer con hasta 10 días de antelación."
      },
      "facts": ["access-booking"]
    },
    {
      "text": { "es": "El aforo es de 300 personas al día." },
      "facts": ["access-capacity"]
    }
  ],
