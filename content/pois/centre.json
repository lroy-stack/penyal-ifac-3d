    {
      "kind": "facts",
      "heading": { "es": "Horario del centro" },
      "items": [
        { "text": { "es": "De lunes a viernes, de 8:30 a 14:30." }, "facts": ["centre-hours"] },
        {
          "text": { "es": "Fines de semana y festivos, de 9:00 a 14:00." },
          "facts": ["centre-hours"]
